<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: bright cyan fill with white stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/leanback_cyan_focus" />
            <stroke android:width="2dp" android:color="@color/white" />
        </shape>
    </item>
    <!-- Selected state (active filter): cyan glass with cyan border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/leanback_cyan_glow_light" />
            <stroke android:width="1.5dp" android:color="@color/leanback_cyan" />
        </shape>
    </item>
    <!-- Normal state: translucent glass -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/white_10" />
            <stroke android:width="1dp" android:color="@color/white_20" />
        </shape>
    </item>
</selector>
