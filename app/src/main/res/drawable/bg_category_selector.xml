<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/leanback_cyan" />
            <stroke android:width="2.5dp" android:color="@color/white" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/tv_card_dark" />
            <stroke android:width="2.5dp" android:color="@color/leanback_cyan" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/leanback_cyan_glow_light" />
            <stroke android:width="1.5dp" android:color="@color/leanback_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/tv_card_dark" />
            <stroke android:width="1dp" android:color="@color/tv_card_border" />
        </shape>
    </item>
</selector>
