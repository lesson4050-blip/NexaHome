<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused & Selected -->
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D38BDF8" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF38BDF8" />
        </shape>
    </item>
    <!-- Focused only -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3838BDF8" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#CC38BDF8" />
        </shape>
    </item>
    <!-- Selected only -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2638BDF8" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#6638BDF8" />
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
