<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/white_20" />
            <stroke android:width="2dp" android:color="@color/leanback_cyan_focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/leanback_cyan_glow" />
            <stroke android:width="1.5dp" android:color="@color/leanback_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/white_08" />
            <stroke android:width="1dp" android:color="@color/white_10" />
        </shape>
    </item>
</selector>
