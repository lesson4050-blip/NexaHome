<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartTvLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/tv_dark_bg</item>
        <item name="android:colorBackground">@color/tv_dark_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowOverscan">true</item>
        <item name="android:hardwareAccelerated">true</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white_60</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>

    <style name="Animation.TvSideSheet" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/tv_side_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/tv_side_sheet_exit</item>
    </style>

    <style name="Theme.TvSideSheetDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.TvSideSheet</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
</resources>
