<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/tv_dark_bg">

    <!-- Background Animated Silk Shader -->
    <com.orbit.tv.launcher.ui.views.SilkShaderView
        android:id="@+id/silk_shader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backdrop_scenery" />

    <View
        android:id="@+id/view_dimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_dimmer" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/overscan_safe_margin_horizontal"
        android:paddingTop="@dimen/overscan_safe_margin_vertical"
        android:paddingEnd="@dimen/overscan_safe_margin_horizontal"
        android:paddingBottom="@dimen/overscan_safe_margin_vertical">

        <!-- Left Sidebar Rail -->
        <LinearLayout
            android:id="@+id/container_sidebar"
            android:layout_width="@dimen/sidebar_width"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_nav_media"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_media"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_home" />

            <ImageButton
                android:id="@+id/btn_nav_history"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_history"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_history" />

            <ImageButton
                android:id="@+id/btn_nav_apps"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_home_apps"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_apps" />

            <ImageButton
                android:id="@+id/btn_nav_iptv"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_iptv"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_iptv" />

            <ImageButton
                android:id="@+id/btn_nav_games"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_optimizer"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_speed" />

            <ImageButton
                android:id="@+id/btn_nav_cast"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_cast"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_cast" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_nav_settings"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/launcher_settings_title"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_launcher_custom" />

            <ImageButton
                android:id="@+id/btn_nav_power"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/nav_power"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_power" />

        </LinearLayout>

        <!-- Main Content Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/container_sidebar"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Scrollable Content Canvas -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_history_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="48dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <!-- Top Main Header -->
                    <LinearLayout
                        android:id="@+id/container_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_nav_tile"
                            android:padding="9dp"
                            android:src="@drawable/ic_nav_history"
                            app:tint="@color/leanback_cyan" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/history_title"
                                android:textColor="@color/white"
                                android:textSize="22sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/history_subtitle"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SECTION 1: System Watch Next (SmartTube, VLC, Kodi, etc.) -->
                    <LinearLayout
                        android:id="@+id/container_watch_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/watch_next_title"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tab_pill"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="@string/watch_next_badge"
                                android:textColor="@color/white"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/watch_next_subtitle"
                            android:textColor="@color/white_60"
                            android:textSize="12sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_watch_next"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_watch_next_card" />

                    </LinearLayout>

                    <!-- SECTION 2: Local Launcher Watch History -->
                    <LinearLayout
                        android:id="@+id/container_local_history_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/history_local_title"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="16sp" />

                            <LinearLayout
                                android:id="@+id/btn_clear_history"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_genre_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_delete"
                                    app:tint="@color/white_80" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/history_btn_clear"
                                    android:textColor="@color/white_90"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Local History Cards Row -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_history"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_media_card" />

                    </LinearLayout>

                    <!-- Empty State Placeholder (when both are empty) -->
                    <LinearLayout
                        android:id="@+id/container_empty"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:alpha="0.3"
                            android:src="@drawable/ic_nav_history"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/history_empty"
                            android:textColor="@color/white_40"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
