<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_focus_app_card"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Icon + Action Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_brand_smarttube" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_action_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_vpn_widget"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/recommended_install"
            android:textColor="@color/leanback_cyan"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- App Title -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="15sp"
        tools:text="SmartTube" />

    <!-- Category Pill -->
    <TextView
        android:id="@+id/tv_category_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tab_pill"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/white_80"
        android:textSize="10sp"
        tools:text="YouTube без рекламы" />

    <!-- Description -->
    <TextView
        android:id="@+id/tv_app_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/white_60"
        android:textSize="11sp"
        tools:text="Просмотр без рекламы, пропуск спонсорских вставок, 4K HDR 60fps." />

</LinearLayout>
