<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0070D18"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/overscan_safe_margin_horizontal"
        android:paddingTop="@dimen/overscan_safe_margin_vertical"
        android:paddingEnd="@dimen/overscan_safe_margin_horizontal"
        android:paddingBottom="@dimen/overscan_safe_margin_vertical">

        <!-- Top Search Bar Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Search Input Pill -->
            <LinearLayout
                android:id="@+id/container_search_input"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/et_search_query"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/search_text"
                    android:textColorHint="@color/search_hint"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btn_clear_query"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="Clear"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_power"
                    android:visibility="gone"
                    app:tint="@color/white_60" />

            </LinearLayout>

            <!-- Voice Button -->
            <ImageButton
                android:id="@+id/btn_dialog_voice"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_circle_mic"
                android:contentDescription="@string/search_voice"
                android:focusable="true"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <!-- Close Dialog Button -->
            <ImageButton
                android:id="@+id/btn_dialog_close"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_power"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Quick Search Target Action Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Search in YouTube -->
            <LinearLayout
                android:id="@+id/btn_action_youtube"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_nav_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_brand_youtube" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/search_btn_youtube"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Search in Google / Web Browser -->
            <LinearLayout
                android:id="@+id/btn_action_web"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_nav_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_brand_google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/search_btn_google"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_search_status_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="@string/search_empty_hint"
                android:textColor="@color/white_40"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Search Results Scroll Container -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <!-- Section 1: Apps Results -->
                <LinearLayout
                    android:id="@+id/section_search_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_header_apps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/search_section_apps"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_search_apps"
                        android:layout_width="match_parent"
                        android:layout_height="124dp"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_app_card" />

                </LinearLayout>

                <!-- Section 2: Movies & Shows Results -->
                <LinearLayout
                    android:id="@+id/section_search_media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_header_media"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/search_section_media"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_search_media"
                        android:layout_width="match_parent"
                        android:layout_height="235dp"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_media_card" />

                </LinearLayout>

                <!-- Empty Search Notice -->
                <TextView
                    android:id="@+id/tv_search_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center"
                    android:text="@string/search_no_results"
                    android:textColor="@color/white_40"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
