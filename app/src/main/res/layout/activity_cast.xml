<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/tv_dark_bg">

    <!-- Background Animated Silk Shader -->
    <com.orbit.tv.launcher.ui.views.SilkShaderView
        android:id="@+id/silk_shader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backdrop_scenery" />

    <View
        android:id="@+id/view_dimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_dimmer" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/overscan_safe_margin_horizontal"
        android:paddingTop="@dimen/overscan_safe_margin_vertical"
        android:paddingEnd="@dimen/overscan_safe_margin_horizontal"
        android:paddingBottom="@dimen/overscan_safe_margin_vertical">

        <!-- Left Sidebar Navigation Rail -->
        <LinearLayout
            android:id="@+id/container_sidebar"
            android:layout_width="@dimen/sidebar_width"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_nav_media"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_media"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_home" />

            <ImageButton
                android:id="@+id/btn_nav_history"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_history"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_history" />

            <ImageButton
                android:id="@+id/btn_nav_apps"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_home_apps"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_apps" />

            <ImageButton
                android:id="@+id/btn_nav_iptv"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_iptv"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_iptv" />

            <ImageButton
                android:id="@+id/btn_nav_games"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_optimizer"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_speed" />

            <ImageButton
                android:id="@+id/btn_nav_cast"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_cast"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_cast" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_nav_settings"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/launcher_settings_title"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_launcher_custom" />

            <ImageButton
                android:id="@+id/btn_nav_power"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/nav_power"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_power" />

        </LinearLayout>

        <!-- Main Cast Canvas Hub -->
        <FrameLayout
            android:id="@+id/container_main_cast"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="28dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/container_sidebar"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Card Cast Hub Container (matching web preview screen_cast) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_focus_app_card"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="26dp">

                <!-- Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_mic"
                        android:padding="10dp"
                        android:src="@drawable/ic_nav_cast" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/cast_header_title"
                            android:textColor="@color/white"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tv_cast_network_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/cast_network_info_format"
                            android:textColor="@color/white_60"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Refresh PIN button -->
                    <Button
                        android:id="@+id/btn_refresh_pin"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_nav_tile"
                        android:focusable="true"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/cast_refresh_pin"
                        android:textColor="@color/white_80"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Divider line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="20dp"
                    android:background="#20FFFFFF" />

                <!-- Two-Column Grid: Left Web Remote QR Box / Right System Mirroring Protocols -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <!-- Left: Web Remote & Direct Stream Card -->
                    <LinearLayout
                        android:layout_width="236dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_focus_app_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tab_pill"
                            android:fontFamily="sans-serif-bold"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="@string/cast_tag_web"
                            android:textColor="@color/white_80"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:text="@string/cast_section_web_title"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:text="@string/cast_section_web_subtitle"
                            android:textColor="@color/white_60"
                            android:textSize="10sp" />

                        <FrameLayout
                            android:layout_width="128dp"
                            android:layout_height="128dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_qr_card"
                            android:padding="6dp">

                            <ImageView
                                android:id="@+id/img_cast_qr"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_qr_code" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:text="@string/cast_qr_hint"
                            android:textColor="@color/white_80"
                            android:textSize="9sp" />

                        <!-- PIN Access Container -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_nav_tile"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/cast_pin_access_label"
                                android:textColor="@color/white_60"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/cast_pairing_pin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:background="@drawable/bg_vpn_widget"
                                android:fontFamily="monospace"
                                android:paddingStart="14dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="3dp"
                                android:text="PIN: 849-210"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif"
                                android:gravity="center"
                                android:text="@string/cast_pin_purpose_hint"
                                android:textColor="@color/white_60"
                                android:textSize="8sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_cast_expiry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Действителен: 15:00"
                            android:textColor="@color/white_60"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <!-- Right: Screen Mirroring Protocols Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <!-- Section Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tab_pill"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:text="@string/cast_tag_system"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-black"
                                android:text="@string/cast_section_mirror_title"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/cast_section_mirror_subtitle"
                            android:textColor="@color/white_60"
                            android:textSize="11sp" />

                        <!-- Protocol 0: DLNA / UPnP Media Renderer (Built-in) -->
                        <LinearLayout
                            android:id="@+id/btn_proto_dlna"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_nav_tile"
                                android:padding="8dp"
                                android:src="@drawable/ic_cast_dlna"
                                app:tint="@color/vpn_emerald" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/cast_proto_dlna_title"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/cast_proto_dlna_desc"
                                    android:textColor="@color/white_60"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/badge_dlna"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_vpn_widget"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:text="@string/cast_proto_dlna_badge"
                                android:textColor="@color/vpn_emerald"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Protocol 1: Miracast (Wi-Fi Display / Windows & Android) -->
                        <LinearLayout
                            android:id="@+id/btn_proto_miracast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_nav_tile"
                                android:padding="8dp"
                                android:src="@drawable/ic_cast_miracast"
                                app:tint="#A855F7" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/cast_proto_miracast_title"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/cast_proto_miracast_desc"
                                    android:textColor="@color/white_60"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/badge_miracast"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_vpn_widget"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:text="@string/cast_badge_connect"
                                android:textColor="#C084FC"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Protocol 2: Google Cast / Chromecast -->
                        <LinearLayout
                            android:id="@+id/btn_proto_chromecast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_nav_tile"
                                android:padding="8dp"
                                android:src="@drawable/ic_cast_chromecast"
                                app:tint="@color/leanback_cyan" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/cast_proto_chromecast_title"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/cast_proto_chromecast_desc"
                                    android:textColor="@color/white_60"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/badge_chromecast"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_vpn_widget"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:text="@string/cast_badge_connect"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Protocol 3: Apple AirPlay -->
                        <LinearLayout
                            android:id="@+id/btn_proto_airplay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_nav_tile"
                                android:padding="8dp"
                                android:src="@drawable/ic_cast_airplay"
                                app:tint="@color/white" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/cast_proto_airplay_title"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif"
                                    android:text="@string/cast_proto_airplay_desc"
                                    android:textColor="@color/white_60"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/badge_airplay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_vpn_widget"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:text="@string/cast_badge_connect"
                                android:textColor="@color/vpn_emerald"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
