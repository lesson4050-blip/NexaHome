<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_focus_app_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="30dp">

    <!-- Header with Close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btn_detail_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_nav_power"
            app:tint="@color/white_60" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Poster Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="240dp"
            app:cardBackgroundColor="@color/tv_card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/iv_detail_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/backdrop_scenery" />

        </androidx.cardview.widget.CardView>

        <!-- Metadata & Synopsis -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Badges Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_detail_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_pill"
                    android:fontFamily="sans-serif-black"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    tools:text="★ 8.6" />

                <TextView
                    android:id="@+id/tv_detail_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/white_60"
                    android:textSize="11sp"
                    tools:text="2024" />

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/white"
                android:textSize="22sp"
                tools:text="Dune: Part Two" />

            <!-- Genres -->
            <TextView
                android:id="@+id/tv_detail_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/leanback_cyan_focus"
                android:textSize="12sp"
                tools:text="Sci-Fi, Adventure, Action" />

            <!-- Synopsis / Description -->
            <TextView
                android:id="@+id/tv_detail_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:maxLines="5"
                android:textColor="@color/white_80"
                android:textSize="12sp"
                tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_action_trailer"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_tab_pill"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Трейлер"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_action_search_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_tab_pill"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Искать в приложениях"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
