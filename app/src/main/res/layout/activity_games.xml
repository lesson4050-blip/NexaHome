<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/tv_dark_bg">

    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backdrop_scenery" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_dimmer" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/overscan_safe_margin_horizontal"
        android:paddingTop="@dimen/overscan_safe_margin_vertical"
        android:paddingEnd="@dimen/overscan_safe_margin_horizontal"
        android:paddingBottom="@dimen/overscan_safe_margin_vertical">

        <!-- Left Sidebar Navigation Rail -->
        <LinearLayout
            android:id="@+id/container_sidebar"
            android:layout_width="@dimen/sidebar_width"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_nav_media"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_media"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_home" />

            <ImageButton
                android:id="@+id/btn_nav_apps"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_home_apps"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_apps" />

            <ImageButton
                android:id="@+id/btn_nav_iptv"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_iptv"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_iptv" />

            <ImageButton
                android:id="@+id/btn_nav_games"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_games"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_games" />

            <ImageButton
                android:id="@+id/btn_nav_cast"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_cast"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_cast" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_nav_power"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/nav_power"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_power" />

        </LinearLayout>

        <!-- Main Content Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/container_sidebar"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Top Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_top_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/topbar_height"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Игровой Центр &amp; Контроллер"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="12:00" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Scrollable Content -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/container_top_bar">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="48dp">

                    <!-- BLOCK 1: GAMEPAD TESTER & BLUETOOTH DIAGNOSTICS -->
                    <LinearLayout
                        android:id="@+id/card_gamepad_tester"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_focus_app_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="Тестер контроллера (D-Pad / Пульт / Геймпад)"
                                android:textColor="@color/vpn_emerald"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_gp_latency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/bg_gamepad_btn"
                                android:fontFamily="monospace"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:text="Задержка: 1.8 мс"
                                android:textColor="@color/vpn_emerald"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_gp_last_key"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/bg_gamepad_btn"
                                android:fontFamily="monospace"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:text="Кнопка: Ожидание..."
                                android:textColor="@color/leanback_cyan"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btn_bluetooth_settings"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_focus_app_card"
                                android:focusable="true"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="+ Bluetooth ТВ"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Visual Gamepad Schematic Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- D-Pad Buttons -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/btn_gp_up"
                                    android:layout_width="32dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_gamepad_btn"
                                    android:gravity="center"
                                    android:text="▲"
                                    android:textColor="@color/white"
                                    android:textSize="11sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/btn_gp_left"
                                        android:layout_width="26dp"
                                        android:layout_height="32dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:text="◀"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                    <View
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_margin="3dp" />

                                    <TextView
                                        android:id="@+id/btn_gp_right"
                                        android:layout_width="26dp"
                                        android:layout_height="32dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:text="▶"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/btn_gp_down"
                                    android:layout_width="32dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/bg_gamepad_btn"
                                    android:gravity="center"
                                    android:text="▼"
                                    android:textColor="@color/white"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Middle Shoulder & System Buttons -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="36dp"
                                android:layout_marginEnd="36dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/btn_gp_l1"
                                        android:layout_width="48dp"
                                        android:layout_height="28dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:text="L1 / L2"
                                        android:textColor="@color/white_80"
                                        android:textSize="10sp" />

                                    <View
                                        android:layout_width="24dp"
                                        android:layout_height="1dp" />

                                    <TextView
                                        android:id="@+id/btn_gp_r1"
                                        android:layout_width="48dp"
                                        android:layout_height="28dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:text="R1 / R2"
                                        android:textColor="@color/white_80"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/btn_gp_back"
                                        android:layout_width="wrap_content"
                                        android:layout_height="28dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:text="BACK"
                                        android:textColor="@color/white_80"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/btn_gp_ok"
                                        android:layout_width="wrap_content"
                                        android:layout_height="28dp"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginEnd="8dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:text="OK / ENTER"
                                        android:textColor="@color/leanback_cyan"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/btn_gp_menu"
                                        android:layout_width="wrap_content"
                                        android:layout_height="28dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:paddingStart="8dp"
                                        android:paddingEnd="8dp"
                                        android:text="MENU"
                                        android:textColor="@color/white_80"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Action Buttons (A, B, X, Y) -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/btn_gp_y"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_gamepad_btn"
                                    android:gravity="center"
                                    android:text="Y"
                                    android:textColor="#FACC15"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="2dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/btn_gp_x"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:text="X"
                                        android:textColor="#38BDF8"
                                        android:textSize="12sp" />

                                    <View
                                        android:layout_width="16dp"
                                        android:layout_height="16dp" />

                                    <TextView
                                        android:id="@+id/btn_gp_b"
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_gamepad_btn"
                                        android:gravity="center"
                                        android:text="B"
                                        android:textColor="#F87171"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/btn_gp_a"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_gamepad_btn"
                                    android:gravity="center"
                                    android:text="A"
                                    android:textColor="#4ADE80"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- BLOCK 2: INSTANT PLAYABLE TV ARCADE GAMES -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Встроенные ретро-игры NES"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- Super Mario Bros. -->
                        <LinearLayout
                            android:id="@+id/card_arcade_snake"
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Super Mario Bros."
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="1985 • Nintendo"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="▶ Запуск"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Tetris -->
                        <LinearLayout
                            android:id="@+id/card_arcade_tetris"
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Tetris"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="1989 • Nintendo"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="▶ Запуск"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Super Mario Bros. 3 -->
                        <LinearLayout
                            android:id="@+id/card_arcade_2048"
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Super Mario Bros. 3"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="1988 • Nintendo"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="▶ Запуск"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Super Mario Bros. 2 -->
                        <LinearLayout
                            android:id="@+id/card_arcade_breaker"
                            android:layout_width="0dp"
                            android:layout_height="104dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Super Mario Bros. 2"
                                android:textColor="@color/white"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="1988 • Nintendo"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="▶ Запуск"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- BLOCK 3: RETRO EMULATORS & ROMS HUB -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Ретро-эмуляторы &amp; ROMs (с диска / флешки)"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- RetroArch -->
                        <LinearLayout
                            android:id="@+id/card_emu_retroarch"
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="RetroArch TV"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Sega / NES / SNES"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- DuckStation -->
                        <LinearLayout
                            android:id="@+id/card_emu_duckstation"
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="DuckStation"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Sony PlayStation 1"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Nostalgia NES -->
                        <LinearLayout
                            android:id="@+id/card_emu_nostalgia"
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Nostalgia.NES"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Dendy 8-bit"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- ROMs Folder Storage -->
                        <LinearLayout
                            android:id="@+id/card_roms_storage"
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="📁 Папка ROMs"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="/storage/ROMs"
                                android:textColor="@color/white_60"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- BLOCK 4: INSTALLED TV GAMES ROW -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Установленные игры на ТВ"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_installed_games"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tv_empty_games"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Сторонние игры еще не установлены. Запустите встроенную аркаду или эмулятор выше."
                        android:textColor="@color/white_60"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
