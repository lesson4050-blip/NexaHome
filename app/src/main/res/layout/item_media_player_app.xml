<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_focus_app_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/iv_player_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_nav_search" />

    <!-- Name & Category -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="SmartTube" />

        <TextView
            android:id="@+id/tv_player_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/white_60"
            android:textSize="11sp"
            tools:text="YouTube плеер без рекламы" />

    </LinearLayout>

    <!-- Badge / Action indicator -->
    <TextView
        android:id="@+id/tv_player_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tab_pill"
        android:fontFamily="sans-serif-bold"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="ОТКРЫТЬ"
        android:textColor="@color/leanback_cyan"
        android:textSize="10sp" />

</LinearLayout>
