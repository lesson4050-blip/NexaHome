<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/tv_dark_bg">

    <!-- 0. Background Animated Silk Shader -->
    <com.orbit.tv.launcher.ui.views.SilkShaderView
        android:id="@+id/silk_shader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 1. Background Backdrop Scenery -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- 2. Cinematic Dimmer Layer -->
    <View
        android:id="@+id/view_dimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_dimmer" />

    <!-- 3. Overscan Safe-Zone (5% boundary) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_safe_zone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/overscan_safe_margin_horizontal"
        android:paddingTop="@dimen/overscan_safe_margin_vertical"
        android:paddingEnd="@dimen/overscan_safe_margin_horizontal"
        android:paddingBottom="@dimen/overscan_safe_margin_vertical">

        <!-- 4. Left Sidebar Navigation Rail -->
        <LinearLayout
            android:id="@+id/container_sidebar"
            android:layout_width="@dimen/sidebar_width"
            android:layout_height="0dp"
            android:elevation="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Primary Nav Tiles: 1. Home, 2. Apps, 3. IPTV, 4. Games, 5. Cast -->
            <ImageButton
                android:id="@+id/btn_nav_media"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_media"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_home" />

            <ImageButton
                android:id="@+id/btn_nav_history"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_history"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_history" />

            <ImageButton
                android:id="@+id/btn_nav_apps"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_home_apps"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_apps" />

            <ImageButton
                android:id="@+id/btn_nav_iptv"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_iptv"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_iptv" />

            <ImageButton
                android:id="@+id/btn_nav_games"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_optimizer"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_speed" />

            <ImageButton
                android:id="@+id/btn_nav_cast"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_cast"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_cast" />

            <!-- Spacer pushes power button to bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_nav_settings"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/launcher_settings_title"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_launcher_custom" />

            <ImageButton
                android:id="@+id/btn_nav_power"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/nav_power"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_power" />

        </LinearLayout>

        <!-- 5. Main Content Canvas -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_main_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:clipChildren="true"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/container_sidebar"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 5.1 Top Bar Component -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_top_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/topbar_height"
                android:elevation="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Search Cluster -->
                <LinearLayout
                    android:id="@+id/search_bar"
                    android:layout_width="@dimen/search_bar_width"
                    android:layout_height="@dimen/search_bar_height"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_search_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_search_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:id="@+id/tv_search_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/search_hint"
                        android:textColor="@color/white_90"
                        android:textSize="14sp" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_voice_search"
                    android:layout_width="@dimen/circle_button_size"
                    android:layout_height="@dimen/circle_button_size"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_circle_mic"
                    android:contentDescription="@string/search_voice"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/search_bar"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/btn_google_assistant"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_assistant_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_voice_search"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_brand_google_assistant" />

                    <TextView
                        android:id="@+id/tv_assistant_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/assistant_btn_search"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- TV Status / Metrics Cluster -->
                <LinearLayout
                    android:id="@+id/cluster_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- VPN Widget Pill -->
                    <LinearLayout
                        android:id="@+id/btn_system_vpn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_vpn_widget"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/iv_vpn_icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_shield" />

                        <TextView
                            android:id="@+id/tv_vpn_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/vpn_status_connected"
                            android:textColor="@color/vpn_emerald"
                            android:textSize="12sp" />

                        <View
                            android:id="@+id/dot_vpn_status"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_circle_button"
                            android:backgroundTint="@color/vpn_emerald" />

                    </LinearLayout>

                    <!-- Wi-Fi Status Icon (Native Android TV Wi-Fi Settings) -->
                    <ImageView
                        android:id="@+id/iv_wifi_status"
                        android:layout_width="@dimen/circle_button_size"
                        android:layout_height="@dimen/circle_button_size"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_circle_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_wifi" />

                    <!-- Date & Clock Display -->
                    <LinearLayout
                        android:id="@+id/cluster_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.04"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="СУББОТА" />

                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:textColor="#E0FFFFFF"
                            android:textSize="11.5sp"
                            tools:text="14 ноября 2026" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-black"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        tools:text="17:31" />

                    <!-- Settings Button -->
                    <ImageButton
                        android:id="@+id/btn_settings"
                        android:layout_width="@dimen/circle_button_size"
                        android:layout_height="@dimen/circle_button_size"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="@string/settings_title"
                        android:focusable="true"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 5.2 Scrollable Content Rows (Leanback Shelf Container) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="0dp"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/container_top_bar">

                <LinearLayout
                    android:id="@+id/container_all_shelves"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="96dp">

                    <!-- Shelf 1: Installed Streaming Apps -->
                    <LinearLayout
                        android:id="@+id/container_apps_shelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_apps"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/shelf_apps_height"
                            android:clipChildren="true"
                            android:clipToPadding="false"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="36dp"
                            android:nestedScrollingEnabled="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_app_card" />

                    </LinearLayout>

                    <!-- Shelf 2: Movies Shelf -->
                    <LinearLayout
                        android:id="@+id/container_movies_shelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/header_movies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/shelf_section_margin"
                            android:paddingStart="8dp"
                            android:paddingEnd="36dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:letterSpacing="0.02"
                                android:shadowColor="#99000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="2"
                                android:text="@string/title_movies"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/tv_movies_subtitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:shadowColor="#80000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="2"
                                android:text="@string/subtitle_movies_trending"
                                android:textColor="#E0FFFFFF"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:id="@+id/btn_filter_movie_genre"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_genre_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="10dp">

                                <TextView
                                    android:id="@+id/tv_current_movie_genre"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/genre_all"
                                    android:textColor="@color/leanback_cyan"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_movies"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/shelf_media_height"
                            android:layout_marginTop="6dp"
                            android:clipChildren="true"
                            android:clipToPadding="false"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="36dp"
                            android:nestedScrollingEnabled="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_media_card" />

                    </LinearLayout>

                    <!-- Shelf 3: TV Series Shelf -->
                    <LinearLayout
                        android:id="@+id/container_series_shelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/header_series"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/shelf_section_margin"
                            android:paddingStart="8dp"
                            android:paddingEnd="36dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:letterSpacing="0.02"
                                android:shadowColor="#99000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="2"
                                android:text="@string/title_series"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/tv_series_subtitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:fontFamily="sans-serif-medium"
                                android:shadowColor="#80000000"
                                android:shadowDx="0"
                                android:shadowDy="1"
                                android:shadowRadius="2"
                                android:text="@string/subtitle_series_top"
                                android:textColor="#E0FFFFFF"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:id="@+id/btn_filter_series_genre"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_genre_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="10dp">

                                <TextView
                                    android:id="@+id/tv_current_series_genre"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="@string/genre_all"
                                    android:textColor="@color/leanback_cyan"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_series"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/shelf_media_height"
                            android:layout_marginTop="6dp"
                            android:clipChildren="true"
                            android:clipToPadding="false"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="36dp"
                            android:nestedScrollingEnabled="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_media_card" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
