<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/tv_dark_bg">

    <!-- Background Animated Silk Shader -->
    <com.orbit.tv.launcher.ui.views.SilkShaderView
        android:id="@+id/silk_shader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Background Wallpaper Image -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backdrop_scenery" />

    <View
        android:id="@+id/view_dimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_dimmer" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/overscan_safe_margin_horizontal"
        android:paddingTop="@dimen/overscan_safe_margin_vertical"
        android:paddingEnd="@dimen/overscan_safe_margin_horizontal"
        android:paddingBottom="@dimen/overscan_safe_margin_vertical">

        <!-- Left Navigation Sidebar -->
        <LinearLayout
            android:id="@+id/container_sidebar"
            android:layout_width="@dimen/sidebar_width"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_nav_media"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_media"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_home" />

            <ImageButton
                android:id="@+id/btn_nav_history"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_history"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_history" />

            <ImageButton
                android:id="@+id/btn_nav_apps"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_home_apps"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_apps" />

            <ImageButton
                android:id="@+id/btn_nav_iptv"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_iptv"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_iptv" />

            <ImageButton
                android:id="@+id/btn_nav_games"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_optimizer"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_speed" />

            <ImageButton
                android:id="@+id/btn_nav_cast"
                android:layout_width="@dimen/sidebar_button_size"
                android:layout_height="@dimen/sidebar_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nav_tile"
                android:contentDescription="@string/nav_cast"
                android:focusable="true"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_cast" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_nav_settings"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/launcher_settings_title"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_launcher_custom" />

            <ImageButton
                android:id="@+id/btn_nav_power"
                android:layout_width="@dimen/circle_button_size"
                android:layout_height="@dimen/circle_button_size"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/nav_power"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_power" />

        </LinearLayout>

        <!-- Main Content Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/container_sidebar"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Scrollable Content Canvas -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_settings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="48dp"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <!-- Top Header -->
                    <LinearLayout
                        android:id="@+id/header_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/launcher_settings_title"
                            android:textColor="@color/white"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/launcher_settings_subtitle"
                            android:textColor="@color/white_60"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- SECTION 1: Storage & Cache -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/settings_section_storage"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <!-- Posters Cache Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_focus_app_card"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Кеш постеров"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_cache_images_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                tools:text="14.2 MB" />

                            <TextView
                                android:id="@+id/btn_clear_image_cache"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_genre_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="@string/settings_btn_clear_images"
                                android:textColor="@color/color_genre_chip_text"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Catalogs Cache Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_focus_app_card"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Кеш каталогов TMDB"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_cache_catalog_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                tools:text="850 KB" />

                            <TextView
                                android:id="@+id/btn_clear_catalog_cache"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_genre_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="@string/settings_btn_clear_catalogs"
                                android:textColor="@color/color_genre_chip_text"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Total Cache Card -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Всего занято"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_cache_total_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="18sp"
                                tools:text="15.0 MB" />

                            <TextView
                                android:id="@+id/btn_clear_all_cache"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_genre_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="@string/settings_btn_clear_all"
                                android:textColor="@color/color_genre_chip_text"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SECTION 2: Wallpaper Theme -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/settings_section_wallpaper"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <!-- Wallpaper Selector Card -->
                        <LinearLayout
                            android:id="@+id/card_select_wallpaper"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_nav_launcher_custom" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/settings_section_wallpaper"
                                    android:textColor="@color/white_60"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_selected_wallpaper_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="17sp"
                                tools:text="Северное сияние (Фото)" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/settings_press_to_change"
                                android:textColor="@color/white_40"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Upload Wallpaper Card -->
                        <LinearLayout
                            android:id="@+id/btn_upload_wallpaper"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_upload" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/settings_btn_upload_wallpaper"
                                    android:textColor="@color/white_60"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans-serif-black"
                                android:text="Своя картинка"
                                android:textColor="@color/white"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/settings_custom_wallpaper_hint"
                                android:textColor="@color/white_40"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SECTION 3: Home Screen Layout -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/settings_section_home"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <!-- Home Layout Selector Card -->
                        <LinearLayout
                            android:id="@+id/card_select_home_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_nav_home" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/settings_home_layout"
                                    android:textColor="@color/white_60"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_selected_home_layout_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="17sp"
                                tools:text="Приложения → Фильмы → Сериалы (Стандарт)" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/settings_press_to_change"
                                android:textColor="@color/white_40"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SECTION 4: Content Language & Preferred Media Player Cards -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Воспроизведение и каталог"
                        android:textColor="@color/leanback_cyan"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <!-- Language Selector Card -->
                        <LinearLayout
                            android:id="@+id/card_select_language"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_language" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/settings_section_language"
                                    android:textColor="@color/white_60"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_selected_language_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="17sp"
                                tools:text="Українська" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/settings_press_to_change"
                                android:textColor="@color/white_40"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Player Selector Card -->
                        <LinearLayout
                            android:id="@+id/card_select_player"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_focus_app_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_media_player" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/settings_section_player"
                                    android:textColor="@color/white_60"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_drop_down" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_selected_player_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/leanback_cyan"
                                android:textSize="17sp"
                                tools:text="Всегда спрашивать" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="@string/settings_press_to_change"
                                android:textColor="@color/white_40"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- SECTION 5: Hidden Applications -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/settings_section_hidden"
                            android:textColor="@color/leanback_cyan"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_hidden_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif"
                            android:textColor="@color/white_60"
                            android:textSize="12sp"
                            tools:text="Скрыто: 2" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btn_unhide_all"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_genre_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/settings_btn_unhide_all"
                            android:textColor="@color/color_genre_chip_text"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Hidden Apps RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_hidden_apps"
                        android:layout_width="match_parent"
                        android:layout_height="124dp"
                        android:layout_marginTop="10dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_hidden_app_card" />

                    <!-- Hidden Apps Compact Empty State -->
                    <LinearLayout
                        android:id="@+id/container_hidden_empty"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_dialog_plate"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/leanback_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="sans-serif"
                            android:text="@string/settings_hidden_empty_compact"
                            android:textColor="@color/white_60"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
