<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="540dp"
    android:minWidth="540dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_focus_app_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header: Protocol Icon, Title & Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_protocol_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_nav_tile"
            android:padding="8dp"
            android:src="@drawable/ic_cast_airplay"
            app:tint="@color/leanback_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Apple AirPlay"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Беспроводная трансляция экрана"
                android:textColor="@color/white_60"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/close_action"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#20FFFFFF" />

    <!-- Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_tile"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_protocol_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4dp"
            android:text="1. Убедитесь, что телефон и ТВ подключены к одному Wi-Fi.\n2. Для приема сигнала трансляции на Android TV требуется приемник AirScreen."
            android:textColor="@color/white_90"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tab_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_wifi"
                app:tint="@color/leanback_cyan" />

            <TextView
                android:id="@+id/tv_dialog_ip_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:text="IP: 192.168.1.100 • Orbit TV"
                android:textColor="@color/white_80"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_secondary_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tab_pill"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/cast_btn_understood"
            android:textAllCaps="false"
            android:textColor="@color/white_80"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_primary_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_vpn_widget"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/cast_btn_install_airscreen"
            android:textAllCaps="false"
            android:textColor="@color/leanback_cyan"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
