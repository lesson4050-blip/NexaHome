<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_container"
    android:layout_width="@dimen/app_card_width"
    android:layout_height="@dimen/app_card_height"
    android:layout_marginEnd="@dimen/card_spacing"
    android:background="@drawable/bg_focus_app_card"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="@dimen/app_card_icon_size"
            android:layout_height="@dimen/app_card_icon_size"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_nav_apps" />

        <TextView
            android:id="@+id/tv_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="YouTube" />

    </LinearLayout>

    <!-- Star / Pin indicator (visible if pinned to favorites shelf) -->
    <ImageView
        android:id="@+id/iv_pin_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_pin"
        app:tint="@color/leanback_cyan_focus"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Eye-off indicator (visible if app is hidden in debloat view) -->
    <ImageView
        android:id="@+id/iv_hidden_indicator"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|start"
        android:src="@drawable/ic_eye_off"
        app:tint="#F87171"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
