<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="520dp"
    android:minWidth="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_focus_app_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header: Shield Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_dialog_shield"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/vpn_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/vpn_dialog_title"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/vpn_dialog_desc"
                android:textColor="@color/white_60"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/close_action"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <!-- VPN Status Card -->
    <LinearLayout
        android:id="@+id/card_vpn_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_focus_media_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:id="@+id/indicator_vpn_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="@color/vpn_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_vpn_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="@string/vpn_active_protected"
                android:textColor="@color/vpn_emerald"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_vpn_tunnel_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Orbit Secure Tunnel • Cloudflare DNS Encrypted"
                android:textColor="@color/white_70"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Main Connect/Disconnect Button -->
    <Button
        android:id="@+id/btn_toggle_vpn"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_nav_tile"
        android:focusable="true"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="@string/vpn_btn_connect"
        android:textColor="@color/vpn_emerald"
        android:textSize="13sp" />

    <!-- Location Selection Section Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="@string/vpn_locations_title"
        android:textColor="@color/leanback_cyan"
        android:textSize="12sp" />

    <!-- Vertical Scrolling Country Server List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_vpn_locations"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Action Buttons: Recommended Apps & System Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_recommended_vpn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_nav_tile"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="Рекомендуемые VPN"
            android:textAllCaps="false"
            android:textColor="@color/leanback_cyan"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_open_system_vpn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tab_pill"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/vpn_btn_system_settings"
            android:textAllCaps="false"
            android:textColor="@color/white_60"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
