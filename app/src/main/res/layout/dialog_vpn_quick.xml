<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="460dp"
    android:minWidth="460dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_focus_app_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header: Shield Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_dialog_shield"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/vpn_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="VPN &amp; Network Shield"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="System VPN Status &amp; Client Dispatcher"
                android:textColor="@color/white_60"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_nav_power"
            app:tint="@color/white_60" />

    </LinearLayout>

    <!-- VPN Status Card -->
    <LinearLayout
        android:id="@+id/card_vpn_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_focus_media_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:id="@+id/indicator_vpn_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="@color/vpn_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_vpn_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="VPN CONNECTED"
                android:textColor="@color/vpn_emerald"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_vpn_tunnel_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Tunnel interface: tun0 • 10.14.0.2"
                android:textColor="@color/white_70"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Installed VPN Applications Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-bold"
        android:text="Installed VPN Clients"
        android:textColor="@color/leanback_cyan"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/container_vpn_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_no_vpn_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="No third-party VPN apps detected (WireGuard, Amnezia, OpenVPN)"
            android:textColor="@color/white_40"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- System VPN Settings Button -->
    <Button
        android:id="@+id/btn_open_system_vpn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_nav_tile"
        android:focusable="true"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:text="System VPN Settings (Android)"
        android:textColor="@color/white"
        android:textSize="12sp" />

</LinearLayout>
