<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_dimmer"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.cardview.widget.CardView
        android:layout_width="740dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/dialog_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingTop="28dp"
            android:paddingEnd="36dp"
            android:paddingBottom="28dp">

            <!-- Dialog Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_nav_iptv"
                    app:tint="@color/leanback_cyan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Управление плейлистами IPTV"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Выберите готовый пресет или загрузите кастомный M3U/M3U8"
                        android:textColor="@color/white_60"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Presets Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-bold"
                android:text="ПРЕСЕТЫ ПЛЕЙЛИСТОВ"
                android:textColor="@color/white_60"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Preset 1: Default Orbit Live -->
                <LinearLayout
                    android:id="@+id/btn_preset_orbit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_app_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Orbit Live HD"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="8 топ HD каналов (Спорт, Новости, Украина)"
                        android:textColor="@color/white_60"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Preset 2: Ukraine Live -->
                <LinearLayout
                    android:id="@+id/btn_preset_ukraine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_app_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Украина (IPTV-ORG)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Каталог открытых украинских каналов"
                        android:textColor="@color/white_60"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Preset 3: World News -->
                <LinearLayout
                    android:id="@+id/btn_preset_news"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_focus_app_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Новости мира"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Международные новостные каналы"
                        android:textColor="@color/white_60"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Custom URL Input Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-bold"
                android:text="ПРЯМАЯ ССЫЛКА НА M3U / M3U8 ПЛЕЙЛИСТ"
                android:textColor="@color/white_60"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_playlist_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_focus_app_card"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:hint="https://example.com/playlist.m3u"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/white_40"
                android:textSize="13sp" />

            <!-- Status and Progress Bar -->
            <LinearLayout
                android:id="@+id/container_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progress_loading"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/leanback_cyan"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_status_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/leanback_cyan"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Загрузка каналов..."
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Action Buttons Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_reset_default"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_focus_app_card"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="Сбросить на Orbit"
                    android:textColor="@color/white_90"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_focus_app_card"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="Закрыть"
                    android:textColor="@color/white_60"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_load_url"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_focus_app_card"
                    android:backgroundTint="@color/leanback_cyan"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:text="Загрузить"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
