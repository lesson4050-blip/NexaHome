<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dialog_dimmer"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="740dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_plate"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="32dp"
        android:paddingEnd="36dp"
        android:paddingBottom="36dp">

        <!-- Dialog Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_nav_iptv"
                app:tint="@color/leanback_cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Управление плейлистами IPTV"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Выберите готовый пресет или загрузите кастомный M3U/M3U8"
                    android:textColor="@color/white_60"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Presets Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="ПРЕСЕТЫ ПЛЕЙЛИСТОВ"
            android:textColor="@color/white_60"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- Preset 1: Default Orbit Live -->
            <LinearLayout
                android:id="@+id/btn_preset_orbit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focus_app_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Orbit Live TV"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Полный базовый пакет (Новости, Кино, Спорт, СНГ)"
                    android:textColor="@color/white_60"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Preset 2: Ukraine Live -->
            <LinearLayout
                android:id="@+id/btn_preset_ukraine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focus_app_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Украина (IPTV-ORG)"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Каталог открытых украинских каналов"
                    android:textColor="@color/white_60"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Preset 3: World News -->
            <LinearLayout
                android:id="@+id/btn_preset_news"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_focus_app_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Новости мира"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="Международные новостные каналы"
                    android:textColor="@color/white_60"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Custom URL Input Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:text="ПРЯМАЯ ССЫЛКА НА M3U / M3U8 ПЛЕЙЛИСТ"
            android:textColor="@color/white_60"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/et_playlist_url"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_app_card"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:hint="https://example.com/playlist.m3u"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/white_40"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_web_import_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/leanback_cyan"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Или откройте в браузере телефона: http://192.168.1.100:8080" />

        <!-- Status and Progress Bar -->
        <LinearLayout
            android:id="@+id/container_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/leanback_cyan"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_status_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/leanback_cyan"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Загрузка каналов..."
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Action Buttons Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset_default"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_focus_app_card"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="Сбросить на Orbit"
                android:textColor="@color/white_90"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_close"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_focus_app_card"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="Закрыть"
                android:textColor="@color/white_60"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_load_url"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_focus_app_card"
                android:backgroundTint="@color/leanback_cyan"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:stateListAnimator="@null"
                android:text="Загрузить"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
