<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_focus_app_card"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Channel Number, Logo, Name, Category & Live Dot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_circle_button"
            android:fontFamily="sans-serif-black"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/leanback_cyan"
            android:textSize="11sp"
            tools:text="001" />

        <ImageView
            android:id="@+id/iv_channel_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_iptv" />

        <TextView
            android:id="@+id/tv_channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Red Bull TV HD" />

        <ImageView
            android:id="@+id/iv_favorite_star"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_star_filled"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_channel_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_circle_button"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/white_60"
            android:textSize="10sp"
            tools:text="Sports" />

        <View
            android:id="@+id/dot_active_indicator"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="@color/leanback_cyan"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Bottom Row: EPG Current Program & Timeline -->
    <TextView
        android:id="@+id/tv_current_program"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/white_90"
        android:textSize="12sp"
        tools:text="Championship Live Match • 2nd Half" />

    <ProgressBar
        android:id="@+id/pb_epg_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="55"
        android:progressTint="@color/leanback_cyan" />

    <TextView
        android:id="@+id/tv_next_program"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/white_40"
        android:textSize="10sp"
        tools:text="Next: Post-Match Analysis &amp; Highlights" />

</LinearLayout>
